{
  "name": "askora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy:build": "npm run db:migrate && npm run build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "react-router typegen && eslint .",
    "lint:fix": "react-router typegen && eslint . --fix",
    "test": "react-router typegen && vitest run",
    "test:watch": "react-router typegen && vitest",
    "test:e2e": "playwright test",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config app/features/auth/auth.server.ts",
    "beta:seed": "node scripts/seed-beta.mjs",
    "db:seed:demo": "DEMO_SEED_CONFIRM=seed-demo-account DEMO_SEED_SCOPE=local node scripts/seed-demo-account.mjs",
    "admin:promote": "node scripts/promote-admin.mjs promote",
    "admin:demote": "node scripts/promote-admin.mjs demote",
    "auth:invite": "node scripts/create-invite-code.mjs",
    "account:cleanup-deletions": "node scripts/cleanup-account-deletions.mjs",
    "prototype:dev": "vite --config design/prototype/vite.config.ts",
    "prototype:build": "vite build --config design/prototype/vite.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.12",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@react-router/node": "^7.16.0",
    "@react-router/serve": "^7.16.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "better-auth": "^1.6.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": "^0.28.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
