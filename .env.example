# Public app metadata
APP_NAME=Askora
APP_URL=http://localhost:5173
PUBLIC_BETA_NOINDEX=true

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Postgres
DATABASE_URL=postgres://askora:askora_local@localhost:5433/askora?sslmode=disable
DIRECT_DATABASE_URL=postgres://askora:askora_local@localhost:5433/askora?sslmode=disable
# Vercel cron bearer secret (required in production; at least 32 characters)
CRON_SECRET=replace-with-a-cron-secret

# Supabase Postgres production examples
# Use the transaction pooler on port 6543 for request/runtime workloads.
# DATABASE_URL=postgresql://app_role.project_ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Use the session pooler on port 5432 for Drizzle migrations/admin scripts.
# DIRECT_DATABASE_URL=postgresql://app_role.project_ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Better Auth (required in production)
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:5173
# Vercel sets this header; change it only to the header owned by your proxy.
TRUSTED_PROXY_IP_HEADER=x-vercel-forwarded-for
# Number of proxy hops appended to X-Forwarded-For when the trusted header is absent.
TRUSTED_PROXY_HOPS=1

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links through Resend (required in production)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Askora <auth@example.com>

# Beta seed script
# The seed script refuses production and requires both flags before resetting
# deterministic beta_* fixture rows.
BETA_SEED_CONFIRM=reset-beta-fixtures
BETA_SEED_SCOPE=local

# Demo seed script
# npm run db:seed:demo bootstraps this completed local target profile
# when it is missing in local/test scopes.
DEMO_SEED_ACCOUNT_EMAIL=local.target@example.test
DEMO_SEED_BOOTSTRAP_TARGET=true
