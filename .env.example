# Public app metadata
APP_NAME=qna-platform
APP_URL=http://localhost:5173
PUBLIC_BETA_NOINDEX=true

# Neon Postgres
# Use the pooled Neon URL for request/runtime workloads.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Use the direct Neon URL for Drizzle migrations/admin scripts.
DIRECT_DATABASE_URL=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Better Auth (required in production)
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links through Resend (required in production)
RESEND_API_KEY=
AUTH_EMAIL_FROM=QNA Platform <auth@example.com>
